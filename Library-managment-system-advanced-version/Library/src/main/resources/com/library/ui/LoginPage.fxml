<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.library.controller.LoginController"
           prefWidth="1050" prefHeight="680"
           styleClass="login-root">

    <!-- 3D Emerald Deep Background -->
    <StackPane style="-fx-background-color: linear-gradient(to bottom right, #022c22 0%, #064e3b 40%, #021a14 100%);" />

    <!-- Ambient Glowing Spheres (3D Glass Lighting) -->
    <StackPane prefWidth="380" prefHeight="380"
               style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, rgba(16,185,129,0.18), transparent);
                      -fx-background-radius: 190;"
               translateX="-340" translateY="-220" />
    <StackPane prefWidth="320" prefHeight="320"
               style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, rgba(52,211,153,0.14), transparent);
                      -fx-background-radius: 160;"
               translateX="360" translateY="240" />

    <!-- 3D Floating Glass Login Card -->
    <VBox alignment="CENTER" spacing="0" maxWidth="440" styleClass="login-card">

        <!-- 3D Emerald Header Band -->
        <VBox alignment="CENTER" spacing="10"
              style="-fx-background-color: linear-gradient(to right, #047857 0%, #059669 50%, #10b981 100%);
                     -fx-background-radius: 20 20 0 0;
                     -fx-padding: 32 36 28 36;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 3);">
            
            <HBox alignment="CENTER" spacing="12">
                <Text text="📚" style="-fx-font-size: 38px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 6, 0, 0, 2);" />
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Text text="LibraCore Pro"
                          style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-fill: white;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 4, 0, 0, 1);" />
                    <Text text="Enterprise Library Management v3.0.0"
                          style="-fx-font-size: 11.5px; -fx-font-weight: 600; -fx-fill: #d1fae5;" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Form Body with 3D White/Glass Container -->
        <VBox spacing="18"
              style="-fx-background-color: rgba(255,255,255,0.96);
                     -fx-background-radius: 0 0 20 20;
                     -fx-padding: 32 36 32 36;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 24, 0, 0, 10);">

            <!-- Error Label -->
            <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="368"
                   style="-fx-text-fill: #dc2626; -fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-background-color: #fee2e2; -fx-background-radius: 8;
                          -fx-border-color: #f87171; -fx-border-radius: 8; -fx-border-width: 1;
                          -fx-padding: 10 14 10 14;" visible="false" managed="false" />

            <!-- Username Field -->
            <VBox spacing="6">
                <Label text="USERNAME OR EMAIL"
                       style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #065f46; -fx-letter-spacing: 0.5px;" />
                <TextField fx:id="usernameField" promptText="Enter admin or librarian username"
                           style="-fx-pref-height: 44px; -fx-font-size: 13.5px;
                                  -fx-background-color: #f0fdf4;
                                  -fx-border-color: #a7f3d0; -fx-border-width: 1.5;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 0 14 0 14;" />
            </VBox>

            <!-- Password Field -->
            <VBox spacing="6">
                <Label text="PASSWORD"
                       style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #065f46; -fx-letter-spacing: 0.5px;" />
                <PasswordField fx:id="passwordField" promptText="Enter secure password"
                               style="-fx-pref-height: 44px; -fx-font-size: 13.5px;
                                      -fx-background-color: #f0fdf4;
                                      -fx-border-color: #a7f3d0; -fx-border-width: 1.5;
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 0 14 0 14;" />
            </VBox>

            <!-- 3D Emerald Submit Button -->
            <Button fx:id="loginButton" text="🔐  SIGN IN TO LIBRACORE" onAction="#handleLogin"
                    maxWidth="Infinity" prefHeight="48"
                    style="-fx-background-color: linear-gradient(to bottom, #10b981 0%, #059669 100%);
                           -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: 800;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #34d399; -fx-border-width: 1 1 0 1; -fx-border-radius: 10;
                           -fx-effect: dropshadow(gaussian, rgba(5,150,105,0.45), 14, 0, 0, 5);" />

            <!-- Footer Actions -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="attemptsLabel" text=""
                       style="-fx-text-fill: #d97706; -fx-font-size: 11.5px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Forgot Password?" onAction="#handleForgotPassword"
                        style="-fx-background-color: transparent; -fx-text-fill: #059669;
                               -fx-font-size: 12px; -fx-font-weight: 600; -fx-cursor: hand; -fx-underline: true;" />
                <Button fx:id="themeToggleBtn" text="🌙 Dark Mode" onAction="#toggleTheme"
                        style="-fx-background-color: #ecfdf5; -fx-text-fill: #065f46;
                               -fx-font-size: 11.5px; -fx-font-weight: 600; -fx-cursor: hand;
                               -fx-border-color: #6ee7b7; -fx-border-radius: 14; -fx-border-width: 1;
                               -fx-background-radius: 14; -fx-padding: 5 12 5 12;" />
            </HBox>

        </VBox>
    </VBox>

</StackPane>
