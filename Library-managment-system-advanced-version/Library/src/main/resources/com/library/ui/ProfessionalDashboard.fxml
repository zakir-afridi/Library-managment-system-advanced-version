<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="com.library.controller.DashboardController"
            styleClass="main-container">

    <!-- ═══ 3D GLOSSY EMERALD TOP BAR ═══ -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="12" right="22" bottom="12" left="18"/></padding>

            <!-- 3D Sidebar Toggle Button -->
            <Button fx:id="sidebarToggleBtn" text="☰" onAction="#toggleSidebar"
                    styleClass="hamburger-btn" style="-fx-font-size:16px;"/>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Text text="📚" style="-fx-font-size: 22px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 1);"/>
                <Text fx:id="appTitleText" text="LibraCore Pro" styleClass="app-title"/>
                <Text fx:id="moduleText"   text="— Visual Analytics &amp; BI Command Center"
                      style="-fx-font-size:13.5px; -fx-font-weight:600; -fx-fill:#d1fae5;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Overdue Alert Pill -->
            <Label fx:id="overdueAlertLabel" text="⚠ 0 Overdue"
                   styleClass="overdue-badge"
                   visible="false" managed="false"/>

            <!-- Weather Widget (compact) -->
            <HBox alignment="CENTER" spacing="6" style="-fx-background-color: rgba(0,0,0,0.2); -fx-padding: 4 10; -fx-background-radius: 20;">
                <Label fx:id="weatherIconLabel" text="☀️" style="-fx-font-size: 13px;"/>
                <Label fx:id="weatherTempLabel" text="--°C" style="-fx-text-fill: #ecfdf5; -fx-font-size: 11.5px; -fx-font-weight: bold;"/>
                <Label fx:id="weatherCityLabel" text="Peshawar" style="-fx-text-fill: #a7f3d0; -fx-font-size: 11px;"/>
            </HBox>

            <Button fx:id="themeToggleBtn" text="🌙" onAction="#toggleTheme"
                    styleClass="top-btn" style="-fx-font-size:14px;"/>
            <Label fx:id="userLabel" text="Welcome, Admin" styleClass="user-label"/>
            <Button fx:id="refreshBtn" text="🔄 Refresh" styleClass="top-btn" onAction="#handleRefresh"/>
            <Button fx:id="logoutBtn"  text="🚪 Logout"  styleClass="logout-btn" onAction="#handleLogout"/>
        </HBox>
    </top>

    <!-- ═══ DEEP OBSIDIAN-GREEN 3D SIDEBAR ═══ -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="235" spacing="6">
            <padding><Insets top="18" bottom="18" left="8" right="8"/></padding>

            <Label text="MAIN NAVIGATION" styleClass="sidebar-header"/>

            <Button fx:id="dashboardBtn"   text="📊  BI Dashboard"    styleClass="sidebar-btn" onAction="#showDashboard"/>
            <Button fx:id="booksBtn"       text="📚  Books"           styleClass="sidebar-btn" onAction="#showBooks"/>
            <Button fx:id="membersBtn"     text="👥  Members"         styleClass="sidebar-btn" onAction="#showMembers"/>
            <Button fx:id="issueReturnBtn" text="🔄  Issue / Return"  styleClass="sidebar-btn" onAction="#showIssueReturn"/>
            <Button fx:id="employeesBtn"   text="👤  Employees"       styleClass="sidebar-btn" onAction="#showEmployees"/>
            <Button fx:id="archiveBtn"     text="📦  Archive"         styleClass="sidebar-btn" onAction="#showArchive"/>
            <Button fx:id="reportsBtn"     text="📈  Reports"         styleClass="sidebar-btn" onAction="#showReports"/>
            <Button fx:id="settingsBtn"    text="⚙️  Settings"        styleClass="sidebar-btn" onAction="#showSettings"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-opacity: 0.15;"/>
            <Button fx:id="sidebarLogoutBtn" text="🚪  Sign Out"
                    styleClass="sidebar-btn, logout" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ═══ MAIN VISUAL ANALYTICS & BI CENTER ═══ -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background-color:transparent; -fx-background:transparent;">
            <VBox fx:id="mainContent" spacing="20"
                  style="-fx-background-color:transparent;">
                <padding><Insets top="18" right="22" bottom="20" left="22"/></padding>

                <!-- ── TIMEFRAME & BI CONTROLS BAR ── -->
                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="filter-bar">
                    <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                    <Label text="📅 Timeframe Horizon:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="timeHorizonCombo" prefWidth="150" promptText="Select Period" styleClass="combo-box" onAction="#handleTimeframeChange"/>
                    <Label fx:id="dateRangeSummaryLabel" text="Real-time aggregation from active database records"
                           style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-style: italic;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="● Live BI Engine" style="-fx-text-fill: #059669; -fx-font-size: 11.5px; -fx-font-weight: bold;"/>
                </HBox>

                <!-- ── 8 3D BUSINESS INTELLIGENCE & DEBTS/DUES KPI CARDS ── -->
                <VBox spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Text text="Business Intelligence &amp; Performance KPIs" styleClass="section-title"/>
                    </HBox>

                    <FlowPane fx:id="kpiFlowPane" hgap="14" vgap="14" prefWrapLength="1100">

                        <!-- 1. Total Inventory & Valuation -->
                        <VBox styleClass="kpi-card, card-books" spacing="6" prefWidth="240">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <StackPane styleClass="kpi-icon-box, icon-books">
                                    <Text text="📚" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="totalBooksText" text="0" styleClass="kpi-number"/>
                                    <Text text="Total Inventory Titles" styleClass="kpi-label"/>
                                    <Text fx:id="booksTrendText" text="▲ In Stock" styleClass="kpi-trend, trend-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- 2. Catalog Asset Valuation -->
                        <VBox styleClass="kpi-card, card-available" spacing="6" prefWidth="240">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <StackPane styleClass="kpi-icon-box, icon-available">
                                    <Text text="💎" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="netStockWorthText" text="PKR 0.00" styleClass="kpi-number" style="-fx-font-size:17px; -fx-fill:#059669;"/>
                                    <Text text="Net Stock Worth" styleClass="kpi-label"/>
                                    <Text fx:id="netStockWorthSub" text="Total Copy Valuation" styleClass="kpi-trend, trend-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- 3. Active Members / Borrowers -->
                        <VBox styleClass="kpi-card, card-members" spacing="6" prefWidth="240">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <StackPane styleClass="kpi-icon-box, icon-members">
                                    <Text text="👥" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="totalMembersText" text="0" styleClass="kpi-number"/>
                                    <Text text="Registered Members" styleClass="kpi-label"/>
                                    <Text fx:id="membersTrendText" text="▲ Active" styleClass="kpi-trend, trend-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- 4. Active Circulation -->
                        <VBox styleClass="kpi-card, card-issued" spacing="6" prefWidth="240">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <StackPane styleClass="kpi-icon-box, icon-issued">
                                    <Text text="📖" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="issuedBooksText" text="0" styleClass="kpi-number"/>
                                    <Text text="Active Borrowings" styleClass="kpi-label"/>
                                    <Text fx:id="issuedTodayText" text="0 today" styleClass="kpi-trend, trend-amber"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- 5. Customer Dues & Receivables -->
                        <VBox styleClass="kpi-card, card-fines" spacing="6" prefWidth="240">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <StackPane styleClass="kpi-icon-box, icon-fines">
                                    <Text text="💳" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="memberDuesText" text="PKR 0.00" styleClass="kpi-number" style="-fx-font-size:17px; -fx-fill:#d97706;"/>
                                    <Text text="Customer Receivables" styleClass="kpi-label"/>
                                    <Text fx:id="memberDuesSub" text="Pending Dues Balance" styleClass="kpi-trend, trend-amber"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- 6. Realized Fines Revenue -->
                        <VBox styleClass="kpi-card, card-fines" spacing="6" prefWidth="240">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <StackPane styleClass="kpi-icon-box, icon-fines">
                                    <Text text="💰" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="finesCollectedText" text="PKR 0.00" styleClass="kpi-number" style="-fx-font-size:17px; -fx-fill:#059669;"/>
                                    <Text text="Paid / Realized Revenue" styleClass="kpi-label"/>
                                    <Text fx:id="pendingFinesText" text="▲ 100% Realized" styleClass="kpi-trend, trend-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- 7. Overdue Risk Accounts -->
                        <VBox styleClass="kpi-card, card-overdue" spacing="6" prefWidth="240">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <StackPane styleClass="kpi-icon-box, icon-overdue">
                                    <Text text="⚠️" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="overdueBooksText" text="0" styleClass="kpi-number"/>
                                    <Text text="Overdue Loans" styleClass="kpi-label"/>
                                    <Text fx:id="overdueRiskAccountsText" text="0 Risk Accounts" styleClass="kpi-trend, trend-danger"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- 8. Stock Availability Rate -->
                        <VBox styleClass="kpi-card, card-available" spacing="6" prefWidth="240">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <StackPane styleClass="kpi-icon-box, icon-available">
                                    <Text text="✅" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="availableBooksText" text="0" styleClass="kpi-number"/>
                                    <Text text="Available Copies" styleClass="kpi-label"/>
                                    <Text fx:id="availabilityRateText" text="Ready for Issue" styleClass="kpi-trend, trend-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                    </FlowPane>
                </VBox>

                <!-- ── 4 PROFESSIONAL VISUAL BI CHARTS (2x2 GRID) ── -->
                <GridPane hgap="18" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    </columnConstraints>

                    <!-- Chart 1: Inventory & Status Distribution -->
                    <VBox styleClass="chart-container" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                        <HBox alignment="CENTER_LEFT">
                            <Text text="📊 Inventory &amp; Stock Distribution" styleClass="chart-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Asset allocation" style="-fx-font-size:11px; -fx-text-fill:#64748b;"/>
                        </HBox>
                        <PieChart fx:id="bookStatusChart" prefHeight="260" animated="true" labelsVisible="true"/>
                    </VBox>

                    <!-- Chart 2: Borrowing Volume & Circulation Trend -->
                    <VBox styleClass="chart-container" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                        <HBox alignment="CENTER_LEFT">
                            <Text text="📈 Circulation &amp; Borrowing Trends" styleClass="chart-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="12-Month Performance" style="-fx-font-size:11px; -fx-text-fill:#64748b;"/>
                        </HBox>
                        <BarChart fx:id="monthlyBarChart" prefHeight="260" animated="true" legendVisible="false">
                            <xAxis><CategoryAxis fx:id="barMonthAxis" label="Timeline"/></xAxis>
                            <yAxis><NumberAxis fx:id="barCountAxis" label="Transactions"/></yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Chart 3: Category Demand & Popularity -->
                    <VBox styleClass="chart-container" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                        <HBox alignment="CENTER_LEFT">
                            <Text text="🏷 Category Analytics &amp; Demand" styleClass="chart-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Top Categories" style="-fx-font-size:11px; -fx-text-fill:#64748b;"/>
                        </HBox>
                        <BarChart fx:id="categoryChart" prefHeight="260" animated="true" legendVisible="false">
                            <xAxis><CategoryAxis fx:id="categoryAxis" label="Genre / Category"/></xAxis>
                            <yAxis><NumberAxis fx:id="categoryCountAxis" label="Book Count"/></yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Chart 4: Financial Recovery & Receivables -->
                    <VBox styleClass="chart-container" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                        <HBox alignment="CENTER_LEFT">
                            <Text text="💵 Revenue &amp; Dues Recovery" styleClass="chart-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Financial Performance" style="-fx-font-size:11px; -fx-text-fill:#64748b;"/>
                        </HBox>
                        <BarChart fx:id="revenueChart" prefHeight="260" animated="true" legendVisible="false">
                            <xAxis><CategoryAxis fx:id="revenueMonthAxis" label="Month"/></xAxis>
                            <yAxis><NumberAxis fx:id="revenueAmountAxis" label="PKR Revenue"/></yAxis>
                        </BarChart>
                    </VBox>

                </GridPane>

                <!-- ── SLEEK LIVE TRANSACTION PULSE (Compact Summary Card) ── -->
                <VBox styleClass="chart-container" spacing="10">
                    <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="2">
                            <Text text="⚡ Real-Time Activity Pulse" styleClass="section-title"/>
                            <Text text="Live feed of circulating stock and transactions" style="-fx-font-size:11.5px; -fx-fill:#64748b;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="searchField" promptText="🔍 Filter activity..." styleClass="search-field" prefWidth="220"/>
                        <Button text="View All Transactions ➔" styleClass="btn, btn-primary" onAction="#showIssueReturn"/>
                    </HBox>

                    <TableView fx:id="activityTable" prefHeight="160" styleClass="styled-table">
                        <columns>
                            <TableColumn fx:id="memberColumn" text="Member / Customer" prefWidth="240"/>
                            <TableColumn fx:id="bookColumn"   text="Book Title" prefWidth="300"/>
                            <TableColumn fx:id="actionColumn" text="Action" prefWidth="120"/>
                            <TableColumn fx:id="dateColumn"   text="Event Date" prefWidth="140"/>
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder><Label text="No recent transactions"/></placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- ═══ 3D STATUS FOOTER BAR ═══ -->
    <bottom>
        <HBox styleClass="footer-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="6" right="20" bottom="6" left="20"/></padding>
            <Label text="● System Online" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 11.5px;"/>
            <Label text="|" style="-fx-text-fill: rgba(255,255,255,0.3);"/>
            <Label text="HikariCP Pool: Active" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11px;"/>
            <Label text="|" style="-fx-text-fill: rgba(255,255,255,0.3);"/>
            <Label text="AES-256 Auth Shield" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="LibraCore Pro v3.0.0 — Enterprise Visual BI Edition"
                   style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px;"/>
        </HBox>
    </bottom>

</BorderPane>
