<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="com.library.controller.DashboardController"
            styleClass="main-container">

    <!-- ═══ 3D GLOSSY EMERALD TOP BAR ═══ -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="12" right="22" bottom="12" left="18"/></padding>

            <!-- 3D Sidebar Toggle Button -->
            <Button fx:id="sidebarToggleBtn" text="☰" onAction="#toggleSidebar"
                    styleClass="hamburger-btn" style="-fx-font-size:16px;"/>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Text text="📚" style="-fx-font-size: 22px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 1);"/>
                <Text fx:id="appTitleText" text="LibraCore Pro" styleClass="app-title"/>
                <Text fx:id="moduleText"   text="— Analytics Dashboard"
                      style="-fx-font-size:13.5px; -fx-font-weight:600; -fx-fill:#d1fae5;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Overdue Pill Badge -->
            <Label fx:id="overdueAlertLabel" text="⚠ 0 Overdue"
                   styleClass="overdue-badge"
                   visible="false" managed="false"/>

            <Button fx:id="themeToggleBtn" text="🌙" onAction="#toggleTheme"
                    styleClass="top-btn" style="-fx-font-size:14px;"/>
            <Label fx:id="userLabel" text="Welcome, Admin" styleClass="user-label"/>
            <Button fx:id="refreshBtn" text="🔄 Refresh" styleClass="top-btn" onAction="#handleRefresh"/>
            <Button fx:id="logoutBtn"  text="🚪 Logout"  styleClass="logout-btn" onAction="#handleLogout"/>
        </HBox>
    </top>

    <!-- ═══ DEEP OBSIDIAN-GREEN 3D SIDEBAR ═══ -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="235" spacing="6">
            <padding><Insets top="18" bottom="18" left="8" right="8"/></padding>

            <Label text="MAIN NAVIGATION" styleClass="sidebar-header"/>

            <Button fx:id="dashboardBtn"   text="📊  Dashboard"       styleClass="sidebar-btn" onAction="#showDashboard"/>
            <Button fx:id="booksBtn"       text="📚  Books"           styleClass="sidebar-btn" onAction="#showBooks"/>
            <Button fx:id="membersBtn"     text="👥  Members"         styleClass="sidebar-btn" onAction="#showMembers"/>
            <Button fx:id="issueReturnBtn" text="🔄  Issue / Return"  styleClass="sidebar-btn" onAction="#showIssueReturn"/>
            <Button fx:id="employeesBtn"   text="👤  Employees"       styleClass="sidebar-btn" onAction="#showEmployees"/>
            <Button fx:id="archiveBtn"     text="📦  Archive"         styleClass="sidebar-btn" onAction="#showArchive"/>
            <Button fx:id="reportsBtn"     text="📈  Reports"         styleClass="sidebar-btn" onAction="#showReports"/>
            <Button fx:id="settingsBtn"    text="⚙️  Settings"        styleClass="sidebar-btn" onAction="#showSettings"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-opacity: 0.15;"/>
            <Button fx:id="sidebarLogoutBtn" text="🚪  Sign Out"
                    styleClass="sidebar-btn, logout" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ═══ MAIN ANALYTICS CENTER ═══ -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background-color:transparent; -fx-background:transparent;">
            <VBox fx:id="mainContent" spacing="22"
                  style="-fx-background-color:transparent;">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

                <!-- ── 3D FLOATING KPI CARDS ── -->
                <VBox spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Text text="Enterprise Overview" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="● Live Database Feed"
                               style="-fx-text-fill: #059669; -fx-font-size: 11.5px; -fx-font-weight: bold;"/>
                    </HBox>

                    <FlowPane fx:id="kpiFlowPane" hgap="16" vgap="16" prefWrapLength="1100">

                        <!-- Total Books -->
                        <VBox styleClass="kpi-card, card-books" spacing="6" prefWidth="205">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane styleClass="kpi-icon-box, icon-books">
                                    <Text text="📚" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="totalBooksText" text="0" styleClass="kpi-number"/>
                                    <Text text="Total Books" styleClass="kpi-label"/>
                                    <Text fx:id="booksTrendText" text="▲ Inventory" styleClass="kpi-trend, trend-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Total Members -->
                        <VBox styleClass="kpi-card, card-members" spacing="6" prefWidth="205">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane styleClass="kpi-icon-box, icon-members">
                                    <Text text="👥" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="totalMembersText" text="0" styleClass="kpi-number"/>
                                    <Text text="Active Members" styleClass="kpi-label"/>
                                    <Text fx:id="membersTrendText" text="▲ Registered" styleClass="kpi-trend, trend-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Issued Books -->
                        <VBox styleClass="kpi-card, card-issued" spacing="6" prefWidth="205">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane styleClass="kpi-icon-box, icon-issued">
                                    <Text text="📖" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="issuedBooksText" text="0" styleClass="kpi-number"/>
                                    <Text text="Books Issued" styleClass="kpi-label"/>
                                    <Text fx:id="issuedTodayText" text="0 today" styleClass="kpi-trend, trend-amber"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Overdue Books -->
                        <VBox styleClass="kpi-card, card-overdue" spacing="6" prefWidth="205">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane styleClass="kpi-icon-box, icon-overdue">
                                    <Text text="⚠️" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="overdueBooksText" text="0" styleClass="kpi-number"/>
                                    <Text text="Overdue Books" styleClass="kpi-label"/>
                                    <Text text="Requires Return" styleClass="kpi-trend, trend-danger"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Available Books -->
                        <VBox styleClass="kpi-card, card-available" spacing="6" prefWidth="205">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane styleClass="kpi-icon-box, icon-available">
                                    <Text text="✅" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="availableBooksText" text="0" styleClass="kpi-number"/>
                                    <Text text="Available Books" styleClass="kpi-label"/>
                                    <Text text="Ready to Borrow" styleClass="kpi-trend, trend-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Fines / Revenue -->
                        <VBox styleClass="kpi-card, card-fines" spacing="6" prefWidth="205">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane styleClass="kpi-icon-box, icon-fines">
                                    <Text text="💰" styleClass="kpi-icon"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Text fx:id="finesCollectedText" text="PKR 0.00" styleClass="kpi-number" style="-fx-font-size:18px; -fx-fill:#059669;"/>
                                    <Text text="Fines Collected" styleClass="kpi-label"/>
                                    <Text fx:id="pendingFinesText" text="Pending: PKR 0.00" styleClass="kpi-trend, trend-amber" style="-fx-font-size:11px;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                    </FlowPane>
                </VBox>

                <!-- ── 3D MULTI-CHART ANALYTICS ── -->
                <HBox spacing="18" alignment="CENTER">

                    <!-- Chart 1: Book Status Distribution -->
                    <VBox styleClass="chart-container" HBox.hgrow="ALWAYS" spacing="10">
                        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                        <HBox alignment="CENTER_LEFT">
                            <Text text="📊 Book Status Distribution" styleClass="chart-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Real-time ratio" style="-fx-font-size:11px; -fx-text-fill:#64748b;"/>
                        </HBox>
                        <PieChart fx:id="bookStatusChart" prefHeight="270" animated="true" labelsVisible="true"/>
                    </VBox>

                    <!-- Chart 2: Monthly Borrowing Trend -->
                    <VBox styleClass="chart-container" HBox.hgrow="ALWAYS" spacing="10">
                        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                        <HBox alignment="CENTER_LEFT">
                            <Text text="📈 Monthly Borrowing Volume" styleClass="chart-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="12-Month Performance" style="-fx-font-size:11px; -fx-text-fill:#64748b;"/>
                        </HBox>
                        <BarChart fx:id="monthlyBarChart" prefHeight="270" animated="true" legendVisible="false">
                            <xAxis><CategoryAxis fx:id="barMonthAxis" label="Timeline"/></xAxis>
                            <yAxis><NumberAxis fx:id="barCountAxis" label="Transactions"/></yAxis>
                        </BarChart>
                    </VBox>

                </HBox>

                <!-- ── FULL-WIDTH RECENT ACTIVITY TABLE ── -->
                <VBox styleClass="table-container" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <VBox spacing="2">
                            <Text text="⚡ Real-Time Activity Log" styleClass="section-title"/>
                            <Text text="Latest book checkouts, returns, and overdue alerts"
                                  style="-fx-font-size:11.5px; -fx-fill:#64748b;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="searchField" promptText="🔍 Instant activity search..."
                                   styleClass="search-field" prefWidth="280"/>
                    </HBox>

                    <TableView fx:id="activityTable" prefHeight="280" styleClass="styled-table">
                        <columns>
                            <TableColumn fx:id="memberColumn" text="Member" prefWidth="220"/>
                            <TableColumn fx:id="bookColumn"   text="Book Title" prefWidth="280"/>
                            <TableColumn fx:id="actionColumn" text="Action Type" prefWidth="130"/>
                            <TableColumn fx:id="dateColumn"   text="Event Date" prefWidth="150"/>
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder><Label text="No recent transactions found"/></placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- ═══ 3D STATUS FOOTER BAR ═══ -->
    <bottom>
        <HBox styleClass="footer-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="6" right="20" bottom="6" left="20"/></padding>
            <Label text="● System Online" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 11.5px;"/>
            <Label text="|" style="-fx-text-fill: rgba(255,255,255,0.3);"/>
            <Label text="HikariCP Pool: Active" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11px;"/>
            <Label text="|" style="-fx-text-fill: rgba(255,255,255,0.3);"/>
            <Label text="AES-256 Auth Shield" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="LibraCore Pro v3.0.0 — Enterprise Library Platform"
                   style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px;"/>
        </HBox>
    </bottom>

</BorderPane>
